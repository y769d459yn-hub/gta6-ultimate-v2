{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carte.schema.json",
  "title": "Fond de carte de Leonida",
  "type": "object",
  "required": ["info", "viewBox", "land", "islands", "lake", "regions", "roads", "keysRegion"],
  "properties": {
    "info": { "type": "string" },
    "viewBox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
    "image": {
      "description": "Image de carte réelle (optionnelle). Si présente, elle remplace le fond vectoriel. Coordonnées dans le même repère que viewBox.",
      "type": "object", "required": ["src", "x", "y", "width", "height", "credit"],
      "properties": { "src": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" }, "credit": { "type": "string" } }
    },
    "land": { "type": "array", "minItems": 3, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } },
    "islands": { "type": "array", "items": { "type": "object", "required": ["id", "region", "pts"] } },
    "lake": { "type": "object", "required": ["cx", "cy", "rx", "ry"] },
    "regions": { "type": "array", "items": { "type": "object", "required": ["id", "nom", "color", "pts"], "properties": { "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } } },
    "roads": { "type": "array", "items": { "type": "array" } },
    "keysRegion": { "type": "object", "required": ["id", "nom", "color"] }
  }
}
