{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accueil.schema.json",
  "title": "Page d'accueil",
  "type": "object",
  "required": ["version", "meta", "hero", "tuiles", "aide", "carte", "enCeMoment"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "meta": {
      "type": "object", "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 10, "maxLength": 70 },
        "description": { "type": "string", "minLength": 50, "maxLength": 160 }
      }
    },
    "hero": {
      "type": "object", "required": ["kicker", "titre", "recherche", "raccourcis"],
      "properties": {
        "kicker": { "type": "string" },
        "titre": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["texte", "style"], "properties": { "texte": { "type": "string" }, "style": { "enum": ["plein", "neon"] } } } },
        "recherche": { "type": "object", "required": ["label", "placeholder", "suggestionsAnimees"], "properties": { "label": { "type": "string" }, "placeholder": { "type": "string" }, "suggestionsAnimees": { "type": "array", "items": { "type": "string" } } } },
        "raccourcis": { "type": "array", "maxItems": 6, "items": { "type": "object", "required": ["label", "q", "icon"], "properties": { "label": { "type": "string" }, "q": { "type": "string" }, "icon": { "type": "string" }, "href": { "type": "string", "pattern": "^[a-z-]+/$" } } } }
      }
    },
    "tuiles": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "required": ["id", "label", "sousTitre", "compteur", "href", "icon", "couleur", "taille"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "label": { "type": "string", "maxLength": 28 },
          "sousTitre": { "type": "string" },
          "compteur": { "enum": ["astuces", "vehicules", "reperes", "actualites", null] },
          "href": { "type": "string", "pattern": "^[a-z-]+/$" },
          "icon": { "type": "string" },
          "couleur": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "taille": { "enum": ["large", "normale"] }
        }
      }
    },
    "aide": { "type": "string" },
    "carte": {
      "type": "object", "required": ["kicker", "titre", "texte", "cta", "vueInitiale"],
      "properties": {
        "cta": { "type": "object", "required": ["label", "href"], "properties": { "label": { "type": "string" }, "href": { "type": "string" } } },
        "vueInitiale": { "type": "object", "required": ["centre", "zoom"], "properties": { "centre": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }, "zoom": { "type": "number", "minimum": 1 } } }
      }
    },
    "enCeMoment": { "type": "object", "required": ["titre", "astuces"], "properties": { "titre": { "type": "string" }, "astuces": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string" } } } }
  }
}
