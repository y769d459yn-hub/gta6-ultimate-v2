{
  "name": "leonida-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Guide GTA 6 visuel : astuces, véhicules, lieux et carte interactive (site statique).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && python3 -m http.server 8080 --directory docs",
    "build:3d": "esbuild tools/3d/index.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=src/vehicule3d.js && node tools/rendus3d.cjs",
    "test": "node scripts/build.mjs && node scripts/verifier.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "three": "0.170.0",
    "esbuild": "0.24.0"
  }
}
